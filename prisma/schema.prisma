generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model SiteConfig {
  id          String  @id @default("main")
  nom         String  @default("Ma Boutique")
  logoUrl     String?
  description String? @default("Vêtements, bijoux et chaussures")
  whatsappNumero String? // format international, ex: 22990000000 (sans +)
  aPropos        String?
  conditionsVente String?
  heroTitre      String? @default("Le style, livré chez vous.")
  heroSousTitre  String? @default("Parcours la collection, commande en quelques clics, paie à la réception. Aucune surprise.")
}

model Categorie {
  id      String  @id @default(cuid())
  nom     String
  slug    String  @unique
  couleur String  @default("bg-blue-50 text-blue-700") // classes Tailwind pour le badge coloré
  ordre   Int     @default(0)

  produits Produit[]

  @@map("categories_boutique")
}

model Produit {
  id          String    @id @default(cuid())
  nom         String
  description String?
  prix        Int // en FCFA
  images      String[]  @default([])
  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  tailles     String[]  @default([]) // ex: ["S","M","L"] ou ["38","39","40"]
  quantite    Int       @default(0)
  publie      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lignesCommande LigneCommande[]
  avis           Avis[]
}

model Avis {
  id          String   @id @default(cuid())
  produit     Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  produitId   String
  nom         String
  note        Int // 1 à 5
  commentaire String?
  createdAt   DateTime @default(now())
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  LIVREE
  ANNULEE
}

model Commande {
  id              String          @id @default(cuid())
  nomClient       String
  telephone       String
  pays            String          @default("Bénin")
  ville           String
  quartier        String
  statut          StatutCommande  @default(EN_ATTENTE)
  total           Int
  vueParAdmin     Boolean         @default(false)
  createdAt       DateTime        @default(now())

  lignes LigneCommande[]
}

model LigneCommande {
  id         String   @id @default(cuid())
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId String
  produit    Produit  @relation(fields: [produitId], references: [id])
  produitId  String
  taille     String?
  quantite   Int
  prixUnitaire Int
}
